# Copy this file to .env.local and fill in real values before deploying.

# Get this from https://resend.com after creating a free account.
# Used to send new-lead emails from the seller form to the business inbox.
RESEND_API_KEY=

# Once you verify your real domain (e.g. dennisbuysvegashouses.com) in the
# Resend dashboard, set this so lead emails send from leads@yourdomain.com
# instead of Resend's shared test domain.
RESEND_FROM_DOMAIN=
